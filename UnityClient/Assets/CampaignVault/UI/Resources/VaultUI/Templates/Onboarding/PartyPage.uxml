<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:cv="CampaignVault.UnityClient.UI.Controls">
    <!-- PartyPageViewModel: the starting level, the characters built so far (and DM drafts to review), and the ways to fill the party. -->
    <ui:Template name="Header" src="QuestionHeader.uxml" />
    <ui:VisualElement>
        <ui:Instance template="Header" />
        <ui:VisualElement name="party-level" class="cv-onboarding__answer">
            <Bindings>
                <cv:ClassBinding property="cls-hidden" data-source-path="ShowLevel" class-name="cv-hidden" invert="true" />
            </Bindings>
            <ui:Label class="cv-caption" text="STARTING LEVEL" />
            <ui:VisualElement class="cv-row cv-levelstep">
                <cv:VaultButton name="party-level-lower" label="−" class="cv-btn--small cv-levelstep__btn">
                    <Bindings>
                        <ui:DataBinding property="command" data-source-path="Lower" binding-mode="ToTarget" />
                        <ui:DataBinding property="enabledSelf" data-source-path="CanLower" binding-mode="ToTarget" />
                    </Bindings>
                </cv:VaultButton>
                <ui:Label name="party-level-value" class="cv-levelstep__value">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="LevelLabel" binding-mode="ToTarget" />
                    </Bindings>
                </ui:Label>
                <cv:VaultButton name="party-level-raise" label="+" class="cv-btn--small cv-levelstep__btn">
                    <Bindings>
                        <ui:DataBinding property="command" data-source-path="Raise" binding-mode="ToTarget" />
                        <ui:DataBinding property="enabledSelf" data-source-path="CanRaise" binding-mode="ToTarget" />
                    </Bindings>
                </cv:VaultButton>
                <ui:Label name="party-level-tier" class="cv-body cv-muted cv-levelstep__tier">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="LevelTier" binding-mode="ToTarget" />
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
            <ui:VisualElement name="party-level-suggestion" class="cv-levelstep__suggest">
                <Bindings>
                    <cv:ClassBinding property="cls-hidden" data-source-path="HasSuggestion" class-name="cv-hidden" invert="true" />
                </Bindings>
                <ui:Label name="party-level-suggestion-text" class="cv-body cv-muted">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="SuggestionText" binding-mode="ToTarget" />
                    </Bindings>
                </ui:Label>
                <cv:Repeater name="party-level-suggestion-actions" item-template="Common/ActionButton" class="cv-row cv-levelstep__actions">
                    <Bindings>
                        <ui:DataBinding property="itemsSource" data-source-path="SuggestionActions" binding-mode="ToTarget" />
                    </Bindings>
                </cv:Repeater>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="party-empty" class="cv-body cv-muted cv-onboarding__answer" text="No characters yet.">
            <Bindings>
                <cv:ClassBinding property="cls-hidden" data-source-path="Empty" class-name="cv-hidden" invert="true" />
            </Bindings>
        </ui:Label>
        <cv:Repeater name="party-members" item-template="Onboarding/PartyCard" class="cv-onboarding__members">
            <Bindings>
                <ui:DataBinding property="itemsSource" data-source-path="Members" binding-mode="ToTarget" />
            </Bindings>
        </cv:Repeater>
        <ui:Label name="party-draft-error" class="cv-body cv-text-blood cv-onboarding__answer">
            <Bindings>
                <ui:DataBinding property="text" data-source-path="DraftError" binding-mode="ToTarget" />
                <cv:ClassBinding property="cls-hidden" data-source-path="DraftError" class-name="cv-hidden" invert="true" />
            </Bindings>
        </ui:Label>
        <cv:ContentPresenter>
            <Bindings>
                <ui:DataBinding property="content" data-source-path="DraftCard" binding-mode="ToTarget" />
            </Bindings>
        </cv:ContentPresenter>
        <cv:Repeater name="party-actions" item-template="Common/ActionButton" class="cv-onboarding__answer cv-onboarding__party-actions">
            <Bindings>
                <ui:DataBinding property="itemsSource" data-source-path="Actions" binding-mode="ToTarget" />
            </Bindings>
        </cv:Repeater>
    </ui:VisualElement>
</ui:UXML>
