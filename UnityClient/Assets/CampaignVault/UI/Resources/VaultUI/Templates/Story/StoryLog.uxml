<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:cv="CampaignVault.UnityClient.UI.Controls">
    <!-- The story (StoryLogViewModel), cloned into Shell.uxml's #Log: the scrolling list, and the button that returns to the newest line. -->
    <ui:ScrollView name="StoryScroll" mode="Vertical" horizontal-scroller-visibility="Hidden" mouse-wheel-scroll-size="60" class="cv-log">
        <cv:LiveRepeater item-template="Story/Narration">
            <Bindings>
                <ui:DataBinding property="itemsSource" data-source-path="Items" binding-mode="ToTarget" />
            </Bindings>
        </cv:LiveRepeater>
    </ui:ScrollView>
    <cv:VaultButton name="StoryJump" label="LATEST" icon="chevron" class="cv-btn--small cv-jump cv-hidden">
        <Bindings>
            <ui:DataBinding property="command" data-source-path="Jump" binding-mode="ToTarget" />
            <cv:ClassBinding property="cls-hidden" data-source-path="ShowJump" class-name="cv-hidden" invert="true" />
        </Bindings>
    </cv:VaultButton>
</ui:UXML>
