<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:cv="CampaignVault.UnityClient.UI.Controls">
    <!-- The DM's notes inside a strip (ActivityLineViewModel). -->
    <ui:Label class="cv-activity__notes">
        <Bindings>
            <ui:DataBinding property="text" data-source-path="Text" binding-mode="ToTarget" />
        </Bindings>
    </ui:Label>
</ui:UXML>
