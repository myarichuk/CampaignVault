<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:cv="CampaignVault.UnityClient.UI.Controls">
    <!-- PickStepViewModel: pickOne / pickN / feats / allocate. -->
    <ui:Template name="Notice" src="OptionsNotice.uxml" />
    <ui:Template name="Filter" src="OptionsFilter.uxml" />
    <ui:VisualElement class="cv-builder__widget">
        <ui:Instance template="Notice" />
        <!-- The background step only: the DM writes backgrounds fitted to the character (PickStepViewModel.ShowWrite). -->
        <ui:VisualElement name="builder-write" class="cv-field-caption">
            <Bindings>
                <cv:ClassBinding property="cls-hidden" data-source-path="ShowWrite" class-name="cv-hidden" invert="true" />
            </Bindings>
            <cv:VaultButton name="builder-write-backgrounds" icon="spark" class="cv-btn--ghost">
                <Bindings>
                    <ui:DataBinding property="label" data-source-path="WriteLabel" binding-mode="ToTarget" />
                    <ui:DataBinding property="command" data-source-path="Write" binding-mode="ToTarget" />
                    <ui:DataBinding property="enabledSelf" data-source-path="CanWrite" binding-mode="ToTarget" />
                    <ui:DataBinding property="tooltip" data-source-path="WriteHint" binding-mode="ToTarget" />
                </Bindings>
            </cv:VaultButton>
            <ui:Label class="cv-body cv-muted">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="WriteNote" binding-mode="ToTarget" />
                    <cv:ClassBinding property="cls-hidden" data-source-path="WriteNote" class-name="cv-hidden" invert="true" />
                </Bindings>
            </ui:Label>
            <ui:Label class="cv-body cv-text-blood">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="WriteError" binding-mode="ToTarget" />
                    <cv:ClassBinding property="cls-hidden" data-source-path="WriteError" class-name="cv-hidden" invert="true" />
                </Bindings>
            </ui:Label>
        </ui:VisualElement>
        <ui:Label class="cv-caption cv-builder__count">
            <Bindings>
                <ui:DataBinding property="text" data-source-path="CountText" binding-mode="ToTarget" />
                <cv:ClassBinding property="cls-hidden" data-source-path="ShowCount" class-name="cv-hidden" invert="true" />
                <cv:ClassBinding property="cls-complete" data-source-path="CountComplete" class-name="cv-text-leaf" />
                <cv:ClassBinding property="cls-over" data-source-path="CountOver" class-name="cv-text-blood" />
            </Bindings>
        </ui:Label>
        <ui:Instance template="Filter" />
        <cv:Repeater item-template="Builder/OptionCard" class="cv-options">
            <Bindings>
                <ui:DataBinding property="itemsSource" data-source-path="Options" binding-mode="ToTarget" />
            </Bindings>
        </cv:Repeater>
    </ui:VisualElement>
</ui:UXML>
