<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Add the solution root as a local package source to resolve local .nupkg files -->
    <add key="LocalFeed" value="." />
    <add key="NuGet.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
