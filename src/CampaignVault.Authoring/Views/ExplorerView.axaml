<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CampaignVault.Authoring.ViewModels"
             x:Class="CampaignVault.Authoring.Views.ExplorerView"
             x:DataType="vm:WorkspaceViewModel">
    <Grid RowDefinitions="Auto, Auto, *">
        <TextBlock Grid.Row="0" Text="Campaign Explorer" FontSize="13" FontWeight="Bold" Margin="5,0,0,8" Foreground="#A0A0AB" />
        <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,10">
            <Button Content="Open Campaign Folder"
                    Command="{Binding OpenCampaignFolderCommand}"
                    Background="#2563EB"
                    Foreground="White"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="8,6"
                    FontSize="11" />
            <TextBlock Text="{Binding WorkspaceStatusMessage}"
                       FontSize="10"
                       Foreground="#71717A"
                       TextWrapping="Wrap" />
        </StackPanel>
        <ListBox Grid.Row="2" ItemsSource="{Binding Files}"
                 SelectedItem="{Binding SelectedFile}"
                 Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:FileNodeViewModel">
                    <Grid ColumnDefinitions="*, Auto" Height="28">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="M19,20H5V4H12V9H17V20M13,3.5L17.5,8H13V3.5M18.5,8H13A1,1 0 0,1 12,7V1.5H4.5A1.5,1.5 0 0,0 3,3V21A1.5,1.5 0 0,0 4.5,22H18.5A1.5,1.5 0 0,0 20,20.5V9.5A1.5,1.5 0 0,0 18.5,8Z" Width="14" Height="14" Foreground="#71717A" />
                            <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" FontSize="11" />
                        </StackPanel>
                        <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="3" Padding="4,1" Background="#2A2A35" Margin="4,0,0,0">
                            <TextBlock Text="{Binding SyncStatus}" FontSize="8" Foreground="#A0A0B0" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
