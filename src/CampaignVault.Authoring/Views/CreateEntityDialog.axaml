<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CampaignVault.Authoring.Views.CreateEntityDialog"
        Title="Create New Entity"
        Width="480" Height="530"
        MinWidth="420" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceColor}" Foreground="{StaticResource TextPrimaryColor}"
        CanResize="False">
    <DockPanel Margin="20">
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16" Spacing="4">
            <TextBlock Text="Create New Entity" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}" />
            <TextBlock Text="Choose an entity type then enter a name." FontSize="12" Foreground="{StaticResource TextSecondaryColor}" />
        </StackPanel>

        <!-- Footer: name + buttons -->
        <Grid DockPanel.Dock="Bottom" RowDefinitions="Auto,Auto" Margin="0,14,0,0">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,12">
                <TextBlock Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextSecondaryColor}" />
                <TextBox Grid.Column="1" Name="NameTextBox"
                         PlaceholderText="Entity nameâ€¦"
                         Background="{StaticResource SurfaceColor}" Foreground="{StaticResource TextPrimaryColor}"
                         BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                         CornerRadius="4" Padding="8,6"
                         KeyDown="NameTextBox_KeyDown" />
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Cancel" Click="Cancel_Click"
                        Background="{StaticResource SurfaceColor}" Foreground="{StaticResource TextSecondaryColor}"
                        BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                        CornerRadius="4" Padding="16,7" />
                <Button Name="CreateButton" Content="Create" Click="Create_Click"
                        Background="{StaticResource AccentColor}" Foreground="White"
                        BorderThickness="0" CornerRadius="4" Padding="16,7"
                        IsEnabled="False" />
            </StackPanel>
        </Grid>

        <!-- Entity type grid -->
        <ListBox Name="TypeListBox"
                 SelectionChanged="TypeListBox_SelectionChanged"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="3" />
                    <Setter Property="CornerRadius" Value="6" />
                    <Setter Property="Background" Value="{StaticResource SurfaceColor}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderColor}" />
                    <Setter Property="BorderThickness" Value="1" />
                </Style>
                <Style Selector="ListBoxItem:selected">
                    <Setter Property="Background" Value="#1D3461" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentColor}" />
                </Style>
                <Style Selector="ListBoxItem:pointerover">
                    <Setter Property="Background" Value="#32324A" />
                </Style>
                <Style Selector="ListBoxItem:selected:pointerover">
                    <Setter Property="Background" Value="#1D3461" />
                </Style>
            </ListBox.Styles>

            <!-- Character -->
            <ListBoxItem Tag="character">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,10">
                    <PathIcon Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"
                              Width="22" Height="22" Foreground="#60A5FA" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="Character" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryColor}" />
                        <TextBlock Text="PCs, NPCs, companions" FontSize="10" Foreground="{StaticResource TextSecondaryColor}" />
                    </StackPanel>
                </StackPanel>
            </ListBoxItem>

            <!-- Location -->
            <ListBoxItem Tag="location">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,10">
                    <PathIcon Data="M12,11.5A2.5,2.5 0 0,1 9.5,9A2.5,2.5 0 0,1 12,6.5A2.5,2.5 0 0,1 14.5,9A2.5,2.5 0 0,1 12,11.5M12,2A7,7 0 0,0 5,9C5,14.25 12,22 12,22C12,22 19,14.25 19,9A7,7 0 0,0 12,2Z"
                              Width="22" Height="22" Foreground="#34D399" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="Location" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryColor}" />
                        <TextBlock Text="Places, dungeons, cities" FontSize="10" Foreground="{StaticResource TextSecondaryColor}" />
                    </StackPanel>
                </StackPanel>
            </ListBoxItem>

            <!-- Quest -->
            <ListBoxItem Tag="quest">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,10">
                    <PathIcon Data="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z"
                              Width="22" Height="22" Foreground="#FBBF24" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="Quest" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryColor}" />
                        <TextBlock Text="Missions, objectives, hooks" FontSize="10" Foreground="{StaticResource TextSecondaryColor}" />
                    </StackPanel>
                </StackPanel>
            </ListBoxItem>

            <!-- Item -->
            <ListBoxItem Tag="item">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,10">
                    <PathIcon Data="M21,16.5C21,16.88 20.79,17.21 20.47,17.38L12.57,21.82C12.41,21.94 12.21,22 12,22C11.79,22 11.59,21.94 11.43,21.82L3.53,17.38C3.21,17.21 3,16.88 3,16.5V7.5C3,7.12 3.21,6.79 3.53,6.62L11.43,2.18C11.59,2.06 11.79,2 12,2C12.21,2 12.41,2.06 12.57,2.18L20.47,6.62C20.79,6.79 21,7.12 21,7.5V16.5M12,4.15L6.04,7.5L12,10.85L17.96,7.5L12,4.15Z"
                              Width="22" Height="22" Foreground="#A78BFA" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="Item" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryColor}" />
                        <TextBlock Text="Weapons, armor, artifacts" FontSize="10" Foreground="{StaticResource TextSecondaryColor}" />
                    </StackPanel>
                </StackPanel>
            </ListBoxItem>

            <!-- Faction -->
            <ListBoxItem Tag="faction">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,10">
                    <PathIcon Data="M12,1L3,5V11C3,16.55 6.84,21.73 12,23C17.16,21.73 21,16.55 21,11V5L12,1Z"
                              Width="22" Height="22" Foreground="#F87171" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="Faction" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryColor}" />
                        <TextBlock Text="Guilds, orders, factions" FontSize="10" Foreground="{StaticResource TextSecondaryColor}" />
                    </StackPanel>
                </StackPanel>
            </ListBoxItem>

            <!-- Lore -->
            <ListBoxItem Tag="lore">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,10">
                    <PathIcon Data="M19,2L14,6.5V17.5L19,13V2M6.5,5C4.55,5 2.45,5.4 1,6.5V21.16C1,21.41 1.25,21.66 1.5,21.66C1.6,21.66 1.65,21.59 1.75,21.59C3.1,20.94 5.05,20.5 6.5,20.5C8.45,20.5 10.55,20.9 12,22C13.35,21.15 15.8,20.5 17.5,20.5C19.15,20.5 20.85,20.81 22.25,21.56C22.35,21.61 22.4,21.59 22.5,21.59C22.75,21.59 23,21.34 23,21.09V6.5C22.4,6.05 21.75,5.75 21,5.5V19C19.9,18.65 18.7,18.5 17.5,18.5C15.8,18.5 13.35,19.15 12,20V6.5C10.55,5.4 8.45,5 6.5,5Z"
                              Width="22" Height="22" Foreground="#FB923C" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="Lore" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryColor}" />
                        <TextBlock Text="History, world knowledge" FontSize="10" Foreground="{StaticResource TextSecondaryColor}" />
                    </StackPanel>
                </StackPanel>
            </ListBoxItem>

            <!-- Rumor -->
            <ListBoxItem Tag="rumor">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,10">
                    <PathIcon Data="M20,2H4A2,2 0 0,0 2,4V22L6,18H20A2,2 0 0,0 22,16V4A2,2 0 0,0 20,2Z"
                              Width="22" Height="22" Foreground="#94A3B8" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="Rumor" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryColor}" />
                        <TextBlock Text="Whispers, secrets, intel" FontSize="10" Foreground="{StaticResource TextSecondaryColor}" />
                    </StackPanel>
                </StackPanel>
            </ListBoxItem>

            <!-- Event -->
            <ListBoxItem Tag="event">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,10">
                    <PathIcon Data="M7,2V13H10V22L17,10H13L17,2H7Z"
                              Width="22" Height="22" Foreground="#38BDF8" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="Event" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryColor}" />
                        <TextBlock Text="Session events, story beats" FontSize="10" Foreground="{StaticResource TextSecondaryColor}" />
                    </StackPanel>
                </StackPanel>
            </ListBoxItem>

            <!-- Custom Creature -->
            <ListBoxItem Tag="customcreature">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,10">
                    <PathIcon Data="M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M8.5,8A1.5,1.5 0 0,1 10,9.5A1.5,1.5 0 0,1 8.5,11A1.5,1.5 0 0,1 7,9.5A1.5,1.5 0 0,1 8.5,8M15.5,8A1.5,1.5 0 0,1 17,9.5A1.5,1.5 0 0,1 15.5,11A1.5,1.5 0 0,1 14,9.5A1.5,1.5 0 0,1 15.5,8M12,17.5C9.67,17.5 7.69,16.04 6.89,14H17.11C16.31,16.04 14.33,17.5 12,17.5Z"
                              Width="22" Height="22" Foreground="#4ADE80" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="Creature" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryColor}" />
                        <TextBlock Text="Homebrew monster stat blocks" FontSize="10" Foreground="{StaticResource TextSecondaryColor}" />
                    </StackPanel>
                </StackPanel>
            </ListBoxItem>

            <!-- Plot Thread -->
            <ListBoxItem Tag="plotthread">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="12,10">
                    <PathIcon Data="M17.5,12A1.5,1.5 0 0,1 16,10.5A1.5,1.5 0 0,1 17.5,9A1.5,1.5 0 0,1 19,10.5A1.5,1.5 0 0,1 17.5,12M14.5,8A1.5,1.5 0 0,1 13,6.5A1.5,1.5 0 0,1 14.5,5A1.5,1.5 0 0,1 16,6.5A1.5,1.5 0 0,1 14.5,8M9.5,8A1.5,1.5 0 0,1 8,6.5A1.5,1.5 0 0,1 9.5,5A1.5,1.5 0 0,1 11,6.5A1.5,1.5 0 0,1 9.5,8M6.5,12A1.5,1.5 0 0,1 5,10.5A1.5,1.5 0 0,1 6.5,9A1.5,1.5 0 0,1 8,10.5A1.5,1.5 0 0,1 6.5,12M12,3A9,9 0 0,0 3,12A9,9 0 0,0 12,21A1.5,1.5 0 0,0 13.5,19.5C13.5,19.11 13.35,18.76 13.11,18.5C12.88,18.24 12.73,17.89 12.73,17.5A1.5,1.5 0 0,1 14.23,16H16A5,5 0 0,0 21,11C21,6.58 16.97,3 12,3Z"
                              Width="22" Height="22" Foreground="#C084FC" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="Plot Thread" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryColor}" />
                        <TextBlock Text="DM narrative arcs, foreshadowing" FontSize="10" Foreground="{StaticResource TextSecondaryColor}" />
                    </StackPanel>
                </StackPanel>
            </ListBoxItem>

        </ListBox>
    </DockPanel>
</Window>

