<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:CampaignVault.Authoring.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CampaignVault.Authoring.Views.HubView"
             x:DataType="vm:MainWindowViewModel">
    <Grid RowDefinitions="Auto, *" ColumnDefinitions="*, 300" IsEnabled="{Binding !Hub.IsBusy}">
        <ProgressBar Grid.Row="0" Grid.ColumnSpan="2"
                     IsIndeterminate="True" 
                     IsVisible="{Binding Hub.IsBusy}" 
                     HorizontalAlignment="Stretch" 
                     Height="4" 
                     Margin="0,0,0,0"
                     Foreground="{StaticResource AccentColor}" />

        <!-- Left: Recent Campaigns -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource BackgroundColor}" Padding="40">
            <StackPanel Spacing="25">
                <TextBlock Text="CampaignVault Authoring" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}" />
                
                <StackPanel Spacing="10">
                    <TextBlock Text="Recent Campaigns" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextSecondaryColor}" />
                    <ScrollViewer Height="300">
                        <ItemsControl ItemsSource="{Binding Hub.RecentCampaigns}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,8" Opacity="{Binding Exists, Converter={x:Static vm:MissingCampaignOpacityConverter.Instance}}">
                                        <Button Grid.Column="0"
                                                Classes="RecentItem"
                                                Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).Hub.OpenCampaignCommand}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding Exists}"
                                                ToolTip.Tip="{Binding Exists, Converter={x:Static vm:CampaignTooltipConverter.Instance}}">
                                            <Border Padding="10,8" CornerRadius="4">
                                                <StackPanel Spacing="6">
                                                    <!-- Campaign name + ruleset -->
                                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding DisplayName}"
                                                                   FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryColor}"
                                                                   VerticalAlignment="Center" />
                                                        <Border Grid.Column="1" Background="{StaticResource SurfaceColor}" Padding="6,2" CornerRadius="2"
                                                                VerticalAlignment="Center"
                                                                IsVisible="{Binding Ruleset, Converter={x:Static vm:NotEmptyConverter.Instance}}">
                                                            <TextBlock Text="{Binding Ruleset}" FontSize="9" Foreground="{StaticResource TextSecondaryColor}" />
                                                        </Border>
                                                    </Grid>

                                                    <!-- Narrative focus tags -->
                                                    <ItemsControl ItemsSource="{Binding NarrativeFocus}"
                                                                   IsVisible="{Binding NarrativeFocus.Count, Converter={x:Static vm:GreaterThanZeroConverter.Instance}}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{StaticResource SurfaceColor}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,4,0">
                                                                    <TextBlock Text="{Binding}" FontSize="9" Foreground="{StaticResource TextSecondaryColor}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- Path (subdued) -->
                                                    <TextBlock Text="{Binding Path}" FontSize="9" Foreground="#52525B" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                        <Button Grid.Column="1"
                                                Classes="RemoveRecentItem"
                                                ToolTip.Tip="Remove from recent"
                                                Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).Hub.RemoveFromRecentCommand}"
                                                CommandParameter="{Binding}"
                                                VerticalAlignment="Top">
                                            <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                                      Width="12" Height="12" Foreground="{StaticResource TextSecondaryColor}" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <TextBlock Text="{Binding Hub.StatusMessage}" FontSize="12" Foreground="#3B82F6" />
            </StackPanel>
        </Border>

        <!-- Right: Actions -->
        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource SurfaceColor}" BorderBrush="{StaticResource SurfaceColor}" BorderThickness="1,0,0,0" Padding="30">
            <ScrollViewer>
                <StackPanel Spacing="20">
                    <TextBlock Text="Actions" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}" Margin="0,0,0,10" />

                    <Button Command="{Binding Hub.CreateNewCampaignCommand}"
                            Background="#10B981" Foreground="White"
                            HorizontalAlignment="Stretch" Padding="15,12" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="16" Height="16" />
                            <TextBlock Text="Create New Campaign" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenCampaignFolderCommand}"
                            Background="#27272A" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                            HorizontalAlignment="Stretch" Padding="15,12" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <PathIcon Data="M20,18H4V8H20M20,6H12L10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6Z" Width="16" Height="16" />
                            <TextBlock Text="Open Local Folder" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Separator Background="{StaticResource SurfaceColor}" Margin="0,10" />

                    <StackPanel Spacing="8">
                        <TextBlock Text="Campaigns Folder" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryColor}" />
                        <TextBlock Text="Optional: Set a folder containing all campaign subdirectories for easier access." FontSize="10" Foreground="#52525B" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Hub.MainViewModel.Settings.CampaignsRootPath, StringFormat='Current: {0}'}"
                                   FontSize="9" Foreground="{StaticResource TextSecondaryColor}" MaxLines="2" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding Hub.MainViewModel.Settings.CampaignsRootPath, Converter={x:Static vm:NotEmptyConverter.Instance}}" />
                        <Button Command="{Binding Hub.SetCampaignsFolderCommand}"
                                Background="#27272A" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                                HorizontalAlignment="Stretch" Padding="12,10" CornerRadius="4" FontSize="11">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="M20,18H4V8H20M20,6H12L10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6Z" Width="14" Height="14" />
                                <TextBlock Text="Set Campaigns Folder" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding Hub.ClearCampaignsFolderCommand}"
                                Background="#2A1F1F" BorderBrush="#4A2F2F" BorderThickness="1"
                                HorizontalAlignment="Stretch" Padding="12,8" CornerRadius="4" FontSize="10"
                                IsVisible="{Binding Hub.MainViewModel.Settings.CampaignsRootPath, Converter={x:Static vm:NotEmptyConverter.Instance}}">
                            <TextBlock Text="Use Recent History" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>

                    <Separator Background="{StaticResource SurfaceColor}" Margin="0,10" />

                    <TextBlock Text="Cloud Discovery" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextSecondaryColor}" />

                    <ListBox ItemsSource="{Binding Hub.RemoteCampaigns}"
                             Background="Transparent" BorderThickness="0"
                             MaxHeight="200"
                             IsVisible="{Binding Hub.IsCloudConnected}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="RecentItem"
                                        Command="{Binding $parent[UserControl].((vm:MainWindowViewModel)DataContext).Hub.DownloadRemoteCampaignCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="M6,2Q4.34,2 3.17,3.17Q2,4.34 2,6V18Q2,19.66 3.17,20.83Q4.34,22 6,22H18Q19.66,22 20.83,20.83Q22,19.66 22,18V6Q22,4.34 20.83,3.17Q19.66,2 18,2H6M6,4H18Q18.83,4 19.41,4.59Q20,5.17 20,6V18Q20,18.83 19.41,19.41Q18.83,20 18,20H6Q5.17,20 4.59,19.41Q4,18.83 4,18V6Q4,5.17 4.59,4.59Q5.17,4 6,4M12,9L7,14H10V17H14V14H17L12,9Z" Width="12" Height="12" Foreground="#3B82F6" />
                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource TextPrimaryColor}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Connect to a Vault to browse remote campaigns."
                               FontSize="11" Foreground="#52525B" TextWrapping="Wrap"
                               IsVisible="{Binding !Hub.IsCloudConnected}" />

                    <Button Content="Connect to Vault"
                            Command="{Binding Hub.RefreshCloudCommand}"
                            HorizontalAlignment="Stretch" Padding="10,8" FontSize="11" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.RecentItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.RecentItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2D2D3D" />
        </Style>
        <Style Selector="Button.RemoveRecentItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.RemoveRecentItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#3F1D1D" />
        </Style>
    </UserControl.Styles>
</UserControl>

