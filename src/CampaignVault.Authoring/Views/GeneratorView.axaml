<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CampaignVault.Authoring.ViewModels"
             x:Class="CampaignVault.Authoring.Views.GeneratorView"
             x:DataType="vm:GenerationViewModel">
    <Grid RowDefinitions="Auto, Auto, Auto, *, *, Auto">
        <TextBlock Grid.Row="0" Text="AI Entity Generator" FontSize="13" FontWeight="Bold" Margin="0,0,0,10" Foreground="{StaticResource TextPrimaryColor}" />
        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,0,0,15" Foreground="{StaticResource TextSecondaryColor}" FontSize="11" />

        <!-- Entity Type Selector -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <TextBlock Text="Entity Type:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryColor}" />
            <ComboBox Name="EntityTypeCombo" SelectedItem="{Binding SelectedEntityType}" Width="120"
                     Background="{StaticResource SurfaceColor}" Foreground="{StaticResource TextPrimaryColor}"
                     BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="8,4">
                <ComboBoxItem>character</ComboBoxItem>
                <ComboBoxItem>location</ComboBoxItem>
                <ComboBoxItem>quest</ComboBoxItem>
                <ComboBoxItem>item</ComboBoxItem>
                <ComboBoxItem>faction</ComboBoxItem>
                <ComboBoxItem>lore</ComboBoxItem>
                <ComboBoxItem>rumor</ComboBoxItem>
                <ComboBoxItem>event</ComboBoxItem>
            </ComboBox>
        </StackPanel>

        <!-- User Prompt -->
        <TextBlock Grid.Row="3" Text="Prompt:" Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,0,4" FontSize="11" />
        <TextBox Grid.Row="3"
                 Text="{Binding UserPrompt, Mode=TwoWay}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 PlaceholderText="Describe the entity to generate..."
                 IsEnabled="{Binding IsEnabled}"
                 Background="{StaticResource BackgroundColor}"
                 BorderBrush="{StaticResource SurfaceColor}"
                 Padding="10"
                 Margin="0,20,0,15" />

        <!-- Generated Result Preview -->
        <TextBlock Grid.Row="4" Text="Generated Result (preview):" Foreground="{StaticResource TextSecondaryColor}" Margin="0,0,0,4" FontSize="11" />
        <TextBox Grid.Row="4"
                 Text="{Binding GenerationResult, Mode=OneWay}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 IsReadOnly="True"
                 Background="{StaticResource BackgroundColor}"
                 BorderBrush="{StaticResource SurfaceColor}"
                 Foreground="{StaticResource TextSecondaryColor}"
                 Padding="10"
                 Margin="0,20,0,15"
                 FontFamily="Consolas"
                 FontSize="10" />

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Spacing="10">
            <Button Content="Generate Entity"
                    Command="{Binding GenerateCommand}"
                    IsEnabled="{Binding CanGenerate}"
                    Background="{StaticResource AccentColor}"
                    Foreground="White"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="10,8" />
            <Button Content="Insert to Active File"
                    Command="{Binding InsertCommand}"
                    IsEnabled="{Binding HasResult}"
                    Background="#27272A"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Padding="10,8" />
        </StackPanel>
    </Grid>
</UserControl>

