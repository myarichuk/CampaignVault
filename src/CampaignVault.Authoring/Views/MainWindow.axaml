<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CampaignVault.Authoring.ViewModels"
        xmlns:views="using:CampaignVault.Authoring.Views"
        xmlns:services="using:CampaignVault.Authoring.Services"
        xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
        x:Class="CampaignVault.Authoring.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="CampaignVault Authoring App"
        Background="#18181F"
        Foreground="#E4E4EB">

    <Window.Resources>
        <vm:EnumToBoolConverter x:Key="EnumToBoolConverter" />
    </Window.Resources>

    <Grid RowDefinitions="Auto, *, 32">
        <!-- Main Menu -->
        <Menu Grid.Row="0" Background="#1C1C24" Foreground="#E4E4EB">
            <MenuItem Header="_File">
                <MenuItem Header="_New Campaign..." />
                <MenuItem Header="_Open Folder..." Command="{Binding OpenCampaignFolderCommand}" />
                <Separator />
                <MenuItem Header="E_xit" />
            </MenuItem>
            <MenuItem Header="_Campaign" IsEnabled="{Binding ApplicationState.CurrentState, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Editor}">
                <MenuItem Header="_Sync Dashboard" />
                <MenuItem Header="_Push All Changes" />
            </MenuItem>
        </Menu>

        <!-- Main Content: Shell Switching -->
        <DockPanel Grid.Row="1">
            <Border DockPanel.Dock="Top" Background="#2D2D3A" Padding="15,5">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Campaign Hub"
                            Command="{Binding BackToHubCommand}"
                            FontSize="11"
                            Padding="8,4"
                            IsVisible="{Binding ApplicationState.CurrentState, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Editor}" />
                    <Button Content="Open Folder" Command="{Binding OpenCampaignFolderCommand}" FontSize="11" Padding="8,4" />
                    <Button Content="Save All" Command="{Binding SaveActiveFileCommand}" FontSize="11" Padding="8,4" IsEnabled="{Binding Workspace.SelectedNode, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </Border>

            <Grid>
                <views:HubView IsVisible="{Binding ApplicationState.CurrentState, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Idle}" />
                <dock:DockControl IsVisible="{Binding ApplicationState.CurrentState, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Editor}"
                                  Layout="{Binding Layout}"
                                  Factory="{Binding Factory}" />
            </Grid>
        </DockPanel>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="#111115" BorderBrush="#2D2D3A" BorderThickness="0,1,0,0" Padding="15,0">
            <Grid ColumnDefinitions="Auto, Auto, *, Auto">
                <!-- MCP Server Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="0,0,20,0" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{Binding Settings.McpStatusColor}" />
                    <TextBlock Text="Authoring MCP: " FontSize="11" Foreground="#71717A" />
                    <TextBlock Text="{Binding Settings.McpStatusText}" FontSize="11" FontWeight="Bold" Foreground="#E4E4EB" />
                </StackPanel>

                <!-- Remote Vault Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{Binding Settings.GrpcStatusColor}" />
                    <TextBlock Text="gRPC Sync: " FontSize="11" Foreground="#71717A" />
                    <TextBlock Text="{Binding Settings.GrpcStatusText}" FontSize="11" FontWeight="Bold" Foreground="#E4E4EB" />
                </StackPanel>

                <!-- Message Info -->
                <TextBlock Grid.Column="2" Text="{Binding Sync.StatusMessage}" FontSize="11" Foreground="#A0A0AB" HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- Last Sync Status -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <TextBlock Text="Last Sync: " FontSize="11" Foreground="#71717A" />
                    <TextBlock Text="{Binding Sync.LastSyncTime}" FontSize="11" FontWeight="Bold" Foreground="#E4E4EB" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
