<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CampaignVault.Authoring.ViewModels"
        xmlns:views="using:CampaignVault.Authoring.Views"
        xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
        x:Class="CampaignVault.Authoring.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="CampaignVault Authoring App"
        Background="{StaticResource BackgroundColor}"
        Foreground="{StaticResource TextPrimaryColor}">

    <Window.Resources>
        <vm:EnumToBoolConverter x:Key="EnumToBoolConverter" />
    </Window.Resources>

    <Grid RowDefinitions="Auto, Auto, *, 32">
        <Menu Grid.Row="0" Background="{StaticResource SurfaceColor}" Foreground="{StaticResource TextPrimaryColor}">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Folder..." Command="{Binding OpenCampaignFolderCommand}" />
                <Separator />
                <MenuItem Header="New Character" Command="{Binding Workspace.CreateNewEntityCommand}" CommandParameter="character" />
                <MenuItem Header="New Location" Command="{Binding Workspace.CreateNewEntityCommand}" CommandParameter="location" />
                <MenuItem Header="New Quest"    Command="{Binding Workspace.CreateNewEntityCommand}" CommandParameter="quest" />
                <MenuItem Header="New Item"     Command="{Binding Workspace.CreateNewEntityCommand}" CommandParameter="item" />
                <Separator />
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" Background="{StaticResource SolRed}" Opacity="0.15" Padding="12,6"
                IsVisible="{Binding ShowStatusBanner}">
            <TextBlock Text="{Binding StatusBannerMessage}" FontSize="11" Foreground="{StaticResource SolRed}" TextWrapping="Wrap" />
        </Border>

        <DockPanel Grid.Row="2">
            <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceColor}" Padding="15,5">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Campaign Hub"
                            Command="{Binding BackToHubCommand}"
                            FontSize="11"
                            Padding="8,4"
                            IsVisible="{Binding ApplicationState.CurrentState, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Editor}" />
                    <Button Content="Open Folder" Command="{Binding OpenCampaignFolderCommand}" FontSize="11" Padding="8,4" />
                    <Button Content="Save" Command="{Binding SaveActiveFileCommand}" FontSize="11" Padding="8,4"
                            IsEnabled="{Binding Workspace.SelectedNode, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Button Content="Delete" Command="{Binding DeleteSelectedEntityCommand}" FontSize="11" Padding="8,4"
                            IsEnabled="{Binding Workspace.SelectedNode, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </Border>

            <Grid>
                <views:HubView IsVisible="{Binding ApplicationState.CurrentState, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Idle}" />
                <dock:DockControl IsVisible="{Binding ApplicationState.CurrentState, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Editor}"
                                  Layout="{Binding Layout}"
                                  Factory="{Binding Factory}" />
            </Grid>
        </DockPanel>

        <Border Grid.Row="3" Background="{StaticResource BackgroundColor}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="15,0">
            <Grid ColumnDefinitions="Auto, Auto, *, Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="0,0,20,0" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{Binding Settings.McpStatusColor}" />
                    <TextBlock Text="MCP: " FontSize="11" Foreground="{StaticResource TextSecondaryColor}" />
                    <TextBlock Text="{Binding Settings.McpStatusText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="main " FontSize="11" Foreground="{StaticResource TextSecondaryColor}" />
                    <TextBlock Text="{Binding StatusBarGit}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}" />
                    <TextBlock Text=" · " FontSize="11" Foreground="{StaticResource TextSecondaryColor}" />
                    <TextBlock Text="{Binding StatusBarSync}" FontSize="11" Foreground="{StaticResource TextSecondaryColor}" />
                    <TextBlock Text=" · Vault " FontSize="11" Foreground="{StaticResource TextSecondaryColor}" />
                    <TextBlock Text="{Binding StatusBarConnection}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding Sync.StatusMessage}" FontSize="11" Foreground="{StaticResource TextSecondaryColor}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <TextBlock Text="Last sync: " FontSize="11" Foreground="{StaticResource TextSecondaryColor}" />
                    <TextBlock Text="{Binding Sync.LastSyncTime}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryColor}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>