<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CampaignVault.Authoring.ViewModels"
             xmlns:dock="clr-namespace:Dock.Controls.ProportionalStackPanel;assembly=Dock.Controls.ProportionalStackPanel"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             x:Class="CampaignVault.Authoring.Views.EditorView"
             x:DataType="vm:MainWindowViewModel">
    <dock:ProportionalStackPanel Orientation="Horizontal" Background="#1A1A1E">
        <!-- Left Editor Pane -->
        <Grid dock:ProportionalStackPanel.Proportion="0.5" RowDefinitions="Auto, *" Margin="12,12,6,12" MinWidth="300">
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="5,0,0,10">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="M19,20H5V4H12V9H17V20M13,3.5L17.5,8H13V3.5M18.5,8H13A1,1 0 0,1 12,7V1.5H4.5A1.5,1.5 0 0,0 3,3V21A1.5,1.5 0 0,0 4.5,22H18.5A1.5,1.5 0 0,0 20,20.5V9.5A1.5,1.5 0 0,0 18.5,8Z" Width="14" Height="14" Foreground="#2563EB" VerticalAlignment="Center" />
                    <TextBlock Text="Editor" FontSize="12" FontWeight="SemiBold" Foreground="#A0A0AB" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Content="Save Changes" Command="{Binding SaveActiveFileCommand}" 
                        Background="#2563EB" Foreground="White" Padding="12,6" FontSize="11" CornerRadius="4" 
                        IsEnabled="{Binding Workspace.SelectedNode, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </Grid>
            <Border Grid.Row="1" BorderBrush="#2D2D3A" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                <ae:TextEditor Name="Editor" 
                               FontFamily="Consolas"
                               FontSize="13"
                               Background="#1F1F28"
                               Foreground="#E4E4EB"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Visible"
                               ShowLineNumbers="True" />
            </Border>
        </Grid>

        <dock:ProportionalStackPanelSplitter />

        <!-- Right Live Preview Pane -->
        <Grid dock:ProportionalStackPanel.Proportion="0.5" RowDefinitions="Auto, *" Margin="6,12,12,12" MinWidth="250">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="5,0,0,10">
                <PathIcon Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z" Width="14" Height="14" Foreground="#10B981" VerticalAlignment="Center" />
                <TextBlock Text="Preview &amp; Properties" FontSize="12" FontWeight="SemiBold" Foreground="#A0A0AB" VerticalAlignment="Center" />
            </StackPanel>
            
            <Border Grid.Row="1" Background="#1C1C24" BorderBrush="#2D2D3A" BorderThickness="1" CornerRadius="4" Padding="0">
                <ScrollViewer>
                    <StackPanel Spacing="0">
                        <!-- Metadata / Form Section -->
                        <Border Background="#23232D" Padding="16" BorderBrush="#2D2D3A" BorderThickness="0,0,0,1">
                            <StackPanel Spacing="12">
                                <TextBlock Text="ENTITY PROPERTIES" FontSize="10" FontWeight="Bold" Foreground="#52525B" LetterSpacing="0.5" />
                                <WrapPanel Orientation="Horizontal">
                                    <!-- Entity Type Badge -->
                                    <Border Background="#2D2D3D" CornerRadius="4" Padding="8,4" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Type" FontWeight="Bold" Foreground="#38BDF8" FontSize="11" />
                                            <TextBlock Text="{Binding EntityTypeDisplay}" Foreground="#E4E4EB" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                    <!-- ID Badge -->
                                    <Border Background="#2D2D3D" CornerRadius="4" Padding="8,4" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="ID" FontWeight="Bold" Foreground="#38BDF8" FontSize="11" />
                                            <TextBlock Text="{Binding ParsedCharacter.Id}" Foreground="#A0A0AB" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                    <!-- Name Field -->
                                    <Border Background="#2D2D3D" CornerRadius="4" Padding="8,4" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Name" FontWeight="Bold" Foreground="#38BDF8" FontSize="11" VerticalAlignment="Center" />
                                            <TextBox Text="{Binding FormName, Mode=TwoWay}" FontSize="11" Padding="4,2" MinWidth="100" Background="#1A1A1E" BorderThickness="0" />
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>

                                <!-- Character Stats -->
                                <StackPanel Spacing="8" IsVisible="{Binding IsCharacter}">
                                    <WrapPanel Orientation="Horizontal">
                                        <Border Background="#2D2D3D" CornerRadius="4" Padding="8,4" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="HP" FontWeight="Bold" Foreground="#F43F5E" FontSize="11" VerticalAlignment="Center" />
                                                <NumericUpDown Value="{Binding FormCurrentHp, Mode=TwoWay}" Minimum="0" Maximum="9999" FormatString="0" ShowButtonSpinner="False" Padding="4,2" FontSize="11" MinWidth="40" Background="#1A1A1E" BorderThickness="0" />
                                                <TextBlock Text="/" Foreground="#71717A" FontSize="11" VerticalAlignment="Center" />
                                                <NumericUpDown Value="{Binding FormMaxHp, Mode=TwoWay}" Minimum="1" Maximum="9999" FormatString="0" ShowButtonSpinner="False" Padding="4,2" FontSize="11" MinWidth="40" Background="#1A1A1E" BorderThickness="0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#2D2D3D" CornerRadius="4" Padding="8,4" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="Will" FontWeight="Bold" Foreground="#10B981" FontSize="11" VerticalAlignment="Center" />
                                                <NumericUpDown Value="{Binding FormWillpower, Mode=TwoWay}" Minimum="0" Maximum="100" FormatString="0" ShowButtonSpinner="False" Padding="4,2" FontSize="11" MinWidth="40" Background="#1A1A1E" BorderThickness="0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#2D2D3D" CornerRadius="4" Padding="8,4" Margin="0,0,8,8">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="Stress" FontWeight="Bold" Foreground="#F59E0B" FontSize="11" VerticalAlignment="Center" />
                                                <NumericUpDown Value="{Binding FormStress, Mode=TwoWay}" Minimum="0" Maximum="100" FormatString="0" ShowButtonSpinner="False" Padding="4,2" FontSize="11" MinWidth="40" Background="#1A1A1E" BorderThickness="0" />
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Rendered Content Section -->
                        <StackPanel Padding="20" Spacing="12">
                            <TextBlock Text="NOTES &amp; DESCRIPTION" FontSize="10" FontWeight="Bold" Foreground="#52525B" LetterSpacing="0.5" />
                            <SelectableTextBlock Text="{Binding PreviewNotes}" 
                                                 TextWrapping="Wrap" 
                                                 FontSize="14" 
                                                 LineHeight="22"
                                                 Foreground="#E4E4EB" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </dock:ProportionalStackPanel>
</UserControl>
