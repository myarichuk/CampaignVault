<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CampaignVault</RootNamespace>
    <AssemblyName>CampaignVault.PluginSdk</AssemblyName>
    <Version>0.13.0</Version>
    <Authors>CampaignVault</Authors>
    <Description>Raven-free plugin contracts and models for CampaignVault out-of-tree plugins.</Description>
    <PackageId>CampaignVault.PluginSdk</PackageId>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/myarichuk/CampaignVault</PackageProjectUrl>
    <RepositoryUrl>https://github.com/myarichuk/CampaignVault</RepositoryUrl>
    <PackageTags>campaignvault;ttrpg;plugin-sdk</PackageTags>
    <!-- Reflection-based by design and never trimmed (TrimMode=partial only trims assemblies marked trimmable).
         Without this, the Docker publish (PublishTrimmed) flows the trim analyzer into this project as IL2026/IL2075 noise. -->
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CampaignVault</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CampaignVault.UnitTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
