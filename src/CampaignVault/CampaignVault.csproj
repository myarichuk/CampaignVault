<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);CampaignVault.Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AllMiniLmL6V2Sharp" Version="0.0.3" />
    <PackageReference Include="Autofac" Version="9.3.4" />
    <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="11.0.2" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.84.0" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.18.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Extensions" Version="0.14.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
    <PackageReference Include="RavenDB.Embedded" Version="7.2.6" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\vault_sync.proto" GrpcServices="Both" />
  </ItemGroup>

  <Import Project="..\..\models\EmbeddingModels.props" />

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CampaignVault.UnitTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Content Include="CampaignVault.Tests\CampaignVault.Tests.csproj" />
    <Content Remove="CampaignVault.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="CampaignVault.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="CampaignVault.Tests\**" />
    <EmbeddedResource Include="RulesetData\**\*.yaml" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="CampaignVault.Tests\**" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\CampaignVault.PluginSdk\CampaignVault.PluginSdk.csproj" />
    <!-- Plugin references: build DLLs but don't reference them in host assembly -->
    <ProjectReference Include="..\..\plugins\CraftingMode\CraftingMode.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\plugins\MedievalWeapons\MedievalWeapons.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\plugins\ShadowAndSteel\ShadowAndSteel.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\plugins\TrailAndHearth\TrailAndHearth.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Copy plugin DLLs and static files to bin/Plugins folder after build -->
  <Target Name="CopyPluginsToOutput" AfterTargets="Build">
    <PropertyGroup>
      <PluginsOutputDir>$(OutDir)Plugins</PluginsOutputDir>
    </PropertyGroup>

    <Message Text="Copying plugins to $(PluginsOutputDir)" Importance="High" />

    <!-- Copy CraftingMode plugin -->
    <ItemGroup>
      <CraftingModeDll Include="..\..\plugins\CraftingMode\bin\$(Configuration)\net10.0\CraftingMode.dll" />
      <CraftingModeManifest Include="..\..\plugins\CraftingMode\plugin.json" />
      <CraftingModeRulesetData Include="..\..\plugins\CraftingMode\RulesetData\**\*.yaml" />
    </ItemGroup>
    <Copy SourceFiles="@(CraftingModeDll)" DestinationFolder="$(PluginsOutputDir)\CraftingMode" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(CraftingModeManifest)" DestinationFolder="$(PluginsOutputDir)\CraftingMode" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(CraftingModeRulesetData)" DestinationFolder="$(PluginsOutputDir)\CraftingMode\RulesetData\%(RecursiveDir)" SkipUnchangedFiles="false" />

    <!-- Copy MedievalWeapons plugin -->
    <ItemGroup>
      <MedievalWeaponsDll Include="..\..\plugins\MedievalWeapons\bin\$(Configuration)\net10.0\MedievalWeapons.dll" />
      <MedievalWeaponsManifest Include="..\..\plugins\MedievalWeapons\plugin.json" />
      <MedievalWeaponsRulesetData Include="..\..\plugins\MedievalWeapons\RulesetData\**\*.yaml" />
    </ItemGroup>
    <Copy SourceFiles="@(MedievalWeaponsDll)" DestinationFolder="$(PluginsOutputDir)\MedievalWeapons" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(MedievalWeaponsManifest)" DestinationFolder="$(PluginsOutputDir)\MedievalWeapons" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(MedievalWeaponsRulesetData)" DestinationFolder="$(PluginsOutputDir)\MedievalWeapons\RulesetData\%(RecursiveDir)" SkipUnchangedFiles="false" />

    <!-- Copy ShadowAndSteel plugin -->
    <ItemGroup>
      <ShadowAndSteelDll Include="..\..\plugins\ShadowAndSteel\bin\$(Configuration)\net10.0\ShadowAndSteel.dll" />
      <ShadowAndSteelManifest Include="..\..\plugins\ShadowAndSteel\plugin.json" />
      <ShadowAndSteelRulesetData Include="..\..\plugins\ShadowAndSteel\RulesetData\**\*.yaml" />
    </ItemGroup>
    <Copy SourceFiles="@(ShadowAndSteelDll)" DestinationFolder="$(PluginsOutputDir)\ShadowAndSteel" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(ShadowAndSteelManifest)" DestinationFolder="$(PluginsOutputDir)\ShadowAndSteel" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(ShadowAndSteelRulesetData)" DestinationFolder="$(PluginsOutputDir)\ShadowAndSteel\RulesetData\%(RecursiveDir)" SkipUnchangedFiles="false" />

    <!-- Copy NecromancersGrimoire plugin -->
    <ItemGroup>
      <NecromancersGrimoireDll Include="..\..\plugins\NecromancersGrimoire\bin\$(Configuration)\net10.0\NecromancersGrimoire.dll" />
      <NecromancersGrimoireManifest Include="..\..\plugins\NecromancersGrimoire\plugin.json" />
      <NecromancersGrimoireRulesetData Include="..\..\plugins\NecromancersGrimoire\RulesetData\**\*.yaml" />
    </ItemGroup>
    <Copy SourceFiles="@(NecromancersGrimoireDll)" DestinationFolder="$(PluginsOutputDir)\NecromancersGrimoire" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(NecromancersGrimoireManifest)" DestinationFolder="$(PluginsOutputDir)\NecromancersGrimoire" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(NecromancersGrimoireRulesetData)" DestinationFolder="$(PluginsOutputDir)\NecromancersGrimoire\RulesetData\%(RecursiveDir)" SkipUnchangedFiles="false" />

    <!-- Copy TrailAndHearth plugin -->
    <ItemGroup>
      <TrailAndHearthDll Include="..\..\plugins\TrailAndHearth\bin\$(Configuration)\net10.0\TrailAndHearth.dll" />
      <TrailAndHearthManifest Include="..\..\plugins\TrailAndHearth\plugin.json" />
      <TrailAndHearthRulesetData Include="..\..\plugins\TrailAndHearth\RulesetData\**\*.yaml" />
    </ItemGroup>
    <Copy SourceFiles="@(TrailAndHearthDll)" DestinationFolder="$(PluginsOutputDir)\TrailAndHearth" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(TrailAndHearthManifest)" DestinationFolder="$(PluginsOutputDir)\TrailAndHearth" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(TrailAndHearthRulesetData)" DestinationFolder="$(PluginsOutputDir)\TrailAndHearth\RulesetData\%(RecursiveDir)" SkipUnchangedFiles="false" />

    <Message Text="Plugins copied successfully" Importance="High" />
  </Target>
</Project>
