#!/bin/bash
# Pre-commit hook: Auto-regenerate MCP descriptors if descriptor source changed
# This keeps disk descriptor files in sync with MetaTools.cs and related source
# (Descriptors are gitignored; regeneration is automatic, not committed)

# Detect changed files in staging area
CHANGED_FILES=$(git diff --cached --name-only)

# Check if any descriptor-related source files are staged
# These are the files whose changes trigger regeneration
if echo "$CHANGED_FILES" | grep -qE '(MetaTools|CommitSchema|ToolCatalog|.*Tools)\.cs$'; then
    echo "Regenerating MCP descriptors..."

    # Regenerate descriptors (must be done before commit)
    export REGENERATE_MCP=1
    dotnet test --filter RegenerateMcpDescriptors -q 2>/dev/null

    if [ $? -eq 0 ]; then
        echo "OK - MCP descriptors regenerated"
    else
        echo "ERROR: Failed to regenerate descriptors. Run: REGENERATE_MCP=1 dotnet test --filter RegenerateMcpDescriptors"
        exit 1
    fi
fi

exit 0
