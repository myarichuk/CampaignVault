<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Check if Docker is available before attempting to build image -->
  <Target Name="CheckDockerAvailable" BeforeTargets="BuildDockerImage">
    <Exec Command="docker --version" ContinueOnError="true" EchoOff="true">
      <Output TaskParameter="ExitCode" PropertyName="DockerExitCode" />
    </Exec>
    <PropertyGroup>
      <DockerAvailable Condition="'$(DockerExitCode)' == '0'">true</DockerAvailable>
      <DockerAvailable Condition="'$(DockerExitCode)' != '0'">false</DockerAvailable>
    </PropertyGroup>
  </Target>

  <!-- Build Docker image before running tests if Docker is available -->
  <Target Name="BuildDockerImage" BeforeTargets="Build" DependsOnTargets="CheckDockerAvailable">
    <Message Condition="'$(DockerAvailable)' == 'true'" Text="[INTEGRATION TESTS] Building Docker image: campaignvault:latest" Importance="high" />
    <Exec Condition="'$(DockerAvailable)' == 'true'" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" Command="docker build -t campaignvault:latest -f ../../Dockerfile ." WorkingDirectory="$(MSBuildProjectDirectory)/../../.." />
    <Message Condition="'$(DockerAvailable)' != 'true'" Text="[INTEGRATION TESTS] WARNING: Docker is not available. Integration tests will be skipped. Install Docker to enable them." Importance="high" />
  </Target>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.3.1" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers" Version="3.7.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CampaignVault\CampaignVault.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>