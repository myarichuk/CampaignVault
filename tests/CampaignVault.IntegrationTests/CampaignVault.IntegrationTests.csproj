<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);NU1902</NoWarn>
  </PropertyGroup>

  <!--
    Deliberately no BuildDockerImage/CheckDockerAvailable targets here: a plain build must never
    shell out to build a Docker image. On a machine with a broken/unresponsive Docker daemon, checking
    the docker CLI version can still succeed while an image build hangs or stalls for a long time,
    which used to stall every plain build in the solution. DockerFactAttribute (see
    DockerFactAttribute.cs) already checks docker installed, daemon running, and image present at
    test-run time, and skips with a clear reason (including the manual build command to run) when any
    of those aren't satisfied - that is the only place image availability should be checked.
  -->

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.3.1" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers" Version="3.7.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CampaignVault\CampaignVault.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>